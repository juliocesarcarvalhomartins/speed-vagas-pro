# Copy to .env only if your launcher loads environment variables. Never commit .env.
SPEED_GOOGLE_SEARCH_KEY=
SPEED_GOOGLE_SEARCH_CX=
SPEED_GOOGLE_DAILY_LIMIT=100
SPEED_GMAIL_SENDER_EMAIL=

# Optional first-use profile values. Leave blank to fill them in the UI.
SPEED_PROFILE_NAME=
SPEED_PROFILE_EMAIL=
SPEED_PROFILE_PHONE=
SPEED_PROFILE_CITY=
SPEED_PROFILE_STATE=
SPEED_PROFILE_RADIUS_KM=30
SPEED_PROFILE_RESUME_PATH=

# Optional automation defaults
SPEED_MIN_SCORE_AUTO=65
SPEED_MAX_AUTO_PER_RUN=5
SPEED_MAX_AUTO_PER_DAY=10
SPEED_AUTO_MANAGER_ENABLED=true
SPEED_AUTO_MANAGER_INTERVAL_MINUTES=60
SPEED_EMAIL_MONITOR_ENABLED=true
SPEED_EMAIL_MONITOR_INTERVAL_MINUTES=10

# Optional safe auto-send (disabled by default)
SPEED_AUTO_SEND_EMAIL=false
SPEED_AUTO_SEND_MIN_SCORE=85
SPEED_AUTO_SEND_DAILY_LIMIT=3
